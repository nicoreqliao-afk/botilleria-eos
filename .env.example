# Copia este archivo a .env y completa los valores.
DATABASE_URL="file:./dev.db"

# Contraseña del panel admin. Usa una larga y propia (12+ caracteres).
ADMIN_PASSWORD="define-una-contraseña-segura"

# Secreto para firmar la sesión (MÍN. 32 caracteres, aleatorio).
# Genéralo con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="genera-un-secreto-largo-y-aleatorio-de-32-o-mas"

# Pon 1 en producción si sirves SIEMPRE por HTTPS (activa HSTS).
ENABLE_HSTS="0"
